# Server Configuration
PORT=8000
CORS_ORIGIN=*

# MongoDB Database Connection URL
MONGODB_URL=mongodb+srv://<username>:<password>@cluster0.mongodb.net/

# JWT Authentication Secrets
ACCESS_TOKEN_SECRET=your_jwt_access_token_secret_here
ACCESS_TOKEN_EXPIRY=1d
REFRESH_TOKEN_SECRET=your_jwt_refresh_token_secret_here
REFRESH_TOKEN_EXPIRY=10d 

# Cloudinary Storage Credentials
CLOUDINARY_CLOUD_NAME=your_cloudinary_cloud_name
CLOUDINARY_API_KEY=your_cloudinary_api_key
CLOUDINARY_API_SECRET=your_cloudinary_api_secret

# Meta AI API Configuration (Exclusively uses Meta Developer API)
# Get your free developer API key from Meta AI
META_API_KEY=your_meta_api_key_here
META_API_BASE_URL=https://api.meta.ai/v1
META_DEFAULT_MODEL=muse-spark-1.3
META_REASONING_MODEL=muse-wonder-1.0
